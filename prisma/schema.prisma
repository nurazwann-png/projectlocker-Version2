generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  username        String?  @unique
  bio             String?
  coverUrl        String?
  coverPosition   String?
  avatarUrl       String?
  links           Json?
  skills          Json?
  notesPin        String?
  preferredView   String?  @default("grid")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Project {
  id               String   @id @default(cuid())
  userId           String
  title            String
  description      String?
  status           String   @default("live")
  liveUrl          String?
  repoUrl          String?
  techStack        Json?
  tags             Json?
  notes            String?
  notesLocked      Boolean  @default(false)
  pinned           Boolean  @default(false)
  deploymentDate   String?
  coverImage       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

// A revocable link (shown as a QR code) that grants read-only access to a portfolio.
// Deleting the row deletes the link; "closed" keeps it but blocks access.
model ShareLink {
  id           String    @id @default(cuid())
  token        String    @unique
  userId       String
  label        String?
  status       String    @default("active")
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model ProjectView {
  id          String   @id @default(cuid())
  projectId   String
  viewerId    String?
  viewerName  String
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([projectId, viewerId])
}

model Comment {
  id             String    @id @default(cuid())
  projectId      String
  parentId       String?
  authorId       String?
  authorName     String
  body           String
  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([projectId])
  @@index([parentId])
}
